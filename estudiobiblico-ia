      function updateClock() {
        const el = document.getElementById('pulpit-clock');
        if (!el) return;
        const totalSec = Math.floor(timerMs / 1000);
        const m = Math.floor(totalSec / 60);
        const s = totalSec % 60;
        el.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        const maxMins = Number(document.getElementById('sermon-mins')?.value) || 30;
        if (m >= maxMins) el.classList.add('alert'); else el.classList.remove('alert');
      }

      function setupTimer() {
        document.getElementById('btn-timer-start')?.addEventListener('click', () => {
          if (!timerInt) {
            timerStart = Date.now() - timerMs;
            timerInt = setInterval(() => { timerMs = Date.now() - timerStart; updateClock(); }, 250);
          }
        });
        document.getElementById('btn-timer-stop')?.addEventListener('click', () => {
          clearInterval(timerInt);
          timerInt = null;
        });
        document.getElementById('btn-timer-reset')?.addEventListener('click', () => {
          clearInterval(timerInt);
          timerInt = null;
          timerMs = 0;
          updateClock();
        });
      }

