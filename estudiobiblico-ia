        // 11. CANVAS DE FIRMA DIGITAL
        const sigCanvas = document.getElementById('signature-canvas');
        if (sigCanvas) {
          const sCtx = sigCanvas.getContext('2d');
          sCtx.lineWidth = 2.5;
          sCtx.lineCap = 'round';
          sCtx.strokeStyle = '#0f172a';
          let sDrawing = false;
          let sDrawn = false;

          function sCoords(e) {
            const r = sigCanvas.getBoundingClientRect();
            if (e.touches && e.touches[0]) {
              return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
            }
            return { x: e.clientX - r.left, y: e.clientY - r.top };
          }
          function sStart(e) { e.preventDefault(); sDrawing = true; const p = sCoords(e); sCtx.beginPath(); sCtx.moveTo(p.x, p.y); }
          function sDraw(e) { if (!sDrawing) return; e.preventDefault(); const p = sCoords(e); sCtx.lineTo(p.x, p.y); sCtx.stroke(); sDrawn = true; }
          function sStop() { sDrawing = false; }

          sigCanvas.addEventListener('mousedown', sStart);
          sigCanvas.addEventListener('mousemove', sDraw);
          sigCanvas.addEventListener('mouseup', sStop);
          sigCanvas.addEventListener('touchstart', sStart, { passive: false });
          sigCanvas.addEventListener('touchmove', sDraw, { passive: false });
          sigCanvas.addEventListener('touchend', sStop);

          document.getElementById('btn-clear-signature')?.addEventListener('click', () => {
            sCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
