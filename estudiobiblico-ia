      // 7. CANVAS NATIVOS: RADAR Y BARRAS
      function renderDashboardCharts() {
        const radarC = document.getElementById('dashboard-radar-canvas');
        if (radarC) {
          const ctx = radarC.getContext('2d');
          const w = radarC.width;
          const h = radarC.height;
          ctx.clearRect(0, 0, w, h);

          const cx = w / 2;
          const cy = h / 2;
          const r = Math.min(cx, cy) - 40;
          const labels = ['Emocional', 'Ansiedad', 'Depresión', 'Familiar', 'Gracia', 'Resiliencia'];
          const values = [78, 68, 74, 82, 88, 80];
          const count = labels.length;

          ctx.strokeStyle = '#334155';
          ctx.lineWidth = 1;
          for (let step = 1; step <= 4; step++) {
            ctx.beginPath();
            const curR = (r / 4) * step;
            for (let i = 0; i < count; i++) {
              const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
              const x = cx + curR * Math.cos(angle);
              const y = cy + curR * Math.sin(angle);
              if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            }
            ctx.closePath();
            ctx.stroke();
          }

          ctx.fillStyle = '#94a3b8';
          ctx.font = '10px sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
            const x = cx + (r + 20) * Math.cos(angle);
            const y = cy + (r + 20) * Math.sin(angle);
            ctx.fillText(labels[i], x, y);
          }

          ctx.fillStyle = 'rgba(16, 185, 129, 0.35)';
          ctx.strokeStyle = '#10b981';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
            const valR = (r * (values[i] / 100));
            const x = cx + valR * Math.cos(angle);
            const y = cy + valR * Math.sin(angle);
            if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
          }
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        }

        const barC = document.getElementById('dashboard-bar-canvas');
        if (barC) {
          const ctx = barC.getContext('2d');
          const w = barC.width;
          const h = barC.height;
          ctx.clearRect(0, 0, w, h);

          const stages = ['Admisión', 'Evaluación', 'Plan 5P', 'Seguimiento', 'Alta'];
          const counts = [3, 2, 4, 3, 2];
          const maxVal = Math.max(...counts, 5);
          const barW = 42;
          const startX = 40;
          const bottomY = h - 35;
          const chartH = h - 70;

          ctx.strokeStyle = '#334155';
          ctx.beginPath();
          ctx.moveTo(startX - 10, bottomY);
          ctx.lineTo(w - 20, bottomY);
          ctx.stroke();

          stages.forEach((label, i) => {
            const x = startX + i * 65;
            const bHeight = (counts[i] / maxVal) * chartH;
            const y = bottomY - bHeight;

            const grad = ctx.createLinearGradient(0, y, 0, bottomY);
            grad.addColorStop(0, '#f59e0b');
            grad.addColorStop(1, '#0f766e');
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.roundRect ? ctx.roundRect(x, y, barW, bHeight, [6, 6, 0, 0]) : ctx.rect(x, y, barW, bHeight);
            ctx.fill();

            ctx.fillStyle = '#f8fafc';
            ctx.font = 'bold 11px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(counts[i], x + barW / 2, y - 6);

            ctx.fillStyle = '#94a3b8';
            ctx.font = '10px sans-serif';
            ctx.fillText(label, x + barW / 2, bottomY + 16);
          });
        }
      }

