      async function computeSHA256(input) {
        if (window.crypto && window.crypto.subtle) {
          try {
            const buf = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(input));
            return 'SHA256:' + Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('').toUpperCase();
          } catch (e) {}
        }
        let h = 0;
        for (let i = 0; i < input.length; i++) h = ((h << 5) - h + input.charCodeAt(i)) | 0;
        return 'SHA256-FB:' + Math.abs(h).toString(16).toUpperCase();
      }

      function downloadFile(content, fileName, mimeType) {
        const b = new Blob([content], { type: mimeType });
        const u = URL.createObjectURL(b);
        const a = document.createElement('a');
        a.href = u;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(() => URL.revokeObjectURL(u), 1000);
      }

      const Narrator = {
        synth: window.speechSynthesis || null,
        speak(text) {
          if (!this.synth) return alert('Síntesis de voz no disponible.');
          this.stop();
          const clean = text.replace(/[*#_~`]/g, '').trim();
          if (!clean) return;
          const u = new SpeechSynthesisUtterance(clean);
          u.rate = 0.95;
          u.lang = 'es-ES';
          const voices = this.synth.getVoices();
          const v = voices.find(x => x.lang.startsWith('es'));
          if (v) u.voice = v;
          u.onend = () => this.updateUI('');
          u.onerror = () => this.updateUI('');
          this.updateUI(clean);
          this.synth.speak(u);
        },
        stop() {
          if (this.synth) this.synth.cancel();
          this.updateUI('');
        },
        updateUI(text) {
          const bar = document.getElementById('voice-player-bar');
          const lbl = document.getElementById('voice-current-text');
          if (!bar) return;
          if (text) {
            bar.style.display = 'flex';
            if (lbl) lbl.textContent = text.slice(0, 50) + '...';
          } else {
            bar.style.display = 'none';
          }
        }
      };

