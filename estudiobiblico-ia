      // 1. MOTOR DE BASE DE DATOS DUAL (IndexedDB + LocalStorage)
      const DB_NAME = 'PastoralMenteDB';
      const DB_VER = 2;
      const LS_PREFIX = 'pbai_';

      const PBAIDB = {
        db: null,
        async init() {
          if (this.db) return this.db;
          return new Promise((resolve) => {
            if (!('indexedDB' in window)) return resolve(null);
            const req = indexedDB.open(DB_NAME, DB_VER);
            req.onupgradeneeded = (e) => {
              const db = e.target.result;
              const stores = ['cases', 'sermons', 'research', 'events', 'goals', 'courses', 'visuals', 'wellbeing', 'notes'];
              stores.forEach((s) => {
                if (!db.objectStoreNames.contains(s)) {
                  db.createObjectStore(s, { keyPath: (s === 'courses' || s === 'wellbeing') ? 'key' : 'id' });
                }
              });
            };
            req.onsuccess = (e) => { this.db = e.target.result; resolve(this.db); };
            req.onerror = () => resolve(null);
          });
        },
        async setItem(store, item) {
          try {
            const list = this.getLS(store) || [];
            const id = item.id || item.key;
            const idx = list.findIndex(x => (x.id || x.key) === id);
            if (idx >= 0) list[idx] = item; else list.unshift(item);
            localStorage.setItem(LS_PREFIX + store, JSON.stringify(list));
          } catch (e) {}

          const db = await this.init();
          if (!db) return item;
          return new Promise(resolve => {
            try {
              const tx = db.transaction(store, 'readwrite');
              tx.objectStore(store).put(item);
              tx.oncomplete = () => resolve(item);
              tx.onerror = () => resolve(item);
            } catch (e) { resolve(item); }
          });
        },
        async getAll(store) {
          const db = await this.init();
          if (!db) return this.getLS(store) || [];
          return new Promise(resolve => {
            try {
              const tx = db.transaction(store, 'readonly');
              const req = tx.objectStore(store).getAll();
              req.onsuccess = () => resolve((req.result && req.result.length > 0) ? req.result : (this.getLS(store) || []));
              req.onerror = () => resolve(this.getLS(store) || []);
            } catch (e) { resolve(this.getLS(store) || []); }
          });
        },
        async deleteItem(store, id) {
          try {
            const list = (this.getLS(store) || []).filter(x => (x.id || x.key) !== id);
            localStorage.setItem(LS_PREFIX + store, JSON.stringify(list));
          } catch (e) {}
          const db = await this.init();
          if (!db) return true;
          return new Promise(resolve => {
            try {
              const tx = db.transaction(store, 'readwrite');
              tx.objectStore(store).delete(id);
              tx.oncomplete = () => resolve(true);
              tx.onerror = () => resolve(false);
            } catch (e) { resolve(false); }
          });
        },
        getLS(store) {
          try {
            const r = localStorage.getItem(LS_PREFIX + store);
            return r ? JSON.parse(r) : null;
          } catch (e) { return null; }
        }
