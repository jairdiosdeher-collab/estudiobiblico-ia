              ${t.slice(1).map(item => `
                <div class="p-1.5 bg-slate-900 rounded flex items-center gap-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span class="text-slate-300 font-serif">${esc(item)}</span>
                </div>
              `).join('')}
            </div>
          `).join('');
        }

        // Bienestar
        document.getElementById('btn-save-wellbeing')?.addEventListener('click', async () => {
          await PBAIDB.setItem('wellbeing', {
            key: 'latest',
            load: document.getElementById('well-load')?.value,
            support: document.getElementById('well-support')?.value,
            date: new Date().toISOString()
          });
          alert('¡Chequeo de bienestar ministerial guardado!');
        });

        // Recursos Visuales (Exportación SVG pura)
        let currentVisual = null;
        document.getElementById('btn-create-visual')?.addEventListener('click', async () => {
          const t = document.getElementById('vis-title')?.value.trim();
          const items = document.getElementById('vis-items')?.value.split(';').map(s => s.trim()).filter(Boolean);
          if (!t || !items.length) return alert('Completa título y conceptos.');
          currentVisual = { id: 'vis-' + Date.now(), title: t, items };
          await PBAIDB.setItem('visuals', currentVisual);

          const out = document.getElementById('visual-preview-output');
          if (out) {
            out.innerHTML = `
              <div class="card border-emerald-500 mt-2 space-y-2">
                <h4 class="card-title text-amber-300">${esc(t)}</h4>
                ${items.map((it, i) => `
                  <div class="p-2 bg-slate-900 rounded border border-teal-500/30 text-xs text-slate-100 font-bold">${i + 1}. ${esc(it)}</div>
                `).join('')}
              </div>
            `;
          }
          refreshKPIs();
        });

        document.getElementById('btn-export-svg')?.addEventListener('click', () => {
          if (!currentVisual) return alert('Crea primero un esquema.');
          const rects = currentVisual.items.map((it, i) => `
            <rect x="40" y="${60 + i * 65}" width="720" height="42" rx="8" fill="#0f172a" stroke="#10b981" stroke-width="2"/>
            <text x="400" y="${86 + i * 65}" text-anchor="middle" fill="#ffffff" font-family="Arial, sans-serif" font-size="15">${esc((i + 1) + '. ' + it)}</text>
          `).join('');

          const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" width="800" height="${Math.max(140, 90 + currentVisual.items.length * 65)}">
              <rect width="100%" height="100%" fill="#020617"/>
              <text x="400" y="36" text-anchor="middle" fill="#fbbf24" font-family="Arial, sans-serif" font-weight="bold" font-size="20">${esc(currentVisual.title)}</text>
              ${rects}
            </svg>
          `;
          downloadFile(svg, `esquema_${currentVisual.title.toLowerCase().replace(/\\s+/g, '_')}.svg`, 'image/svg+xml');
        });

        // 18. RESPALDOS JSON
        document.getElementById('btn-export-backup')?.addEventListener('click', async () => {
          const data = {
            app: 'PastoralMente Bíblica AI',
            exportedAt: new Date().toISOString(),
            cases: await PBAIDB.getAll('cases'),
            sermons: await PBAIDB.getAll('sermons'),
            research: await PBAIDB.getAll('research'),
            notes: await PBAIDB.getAll('notes'),
            events: await PBAIDB.getAll('events'),
            goals: await PBAIDB.getAll('goals'),
            courses: await PBAIDB.getAll('courses'),
            visuals: await PBAIDB.getAll('visuals')
          };
          downloadFile(JSON.stringify(data, null, 2), `pastoralmente_respaldo_${new Date().toISOString().slice(0, 10)}.json`, 'application/json');
        });

        const fileIn = document.getElementById('input-import-file');
        document.getElementById('btn-import-backup')?.addEventListener('click', () => fileIn?.click());
        fileIn?.addEventListener('change', async (e) => {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          try {
            const json = JSON.parse(await file.text());
            if (confirm('¿Restaurar los registros desde este archivo de respaldo?')) {
              if (Array.isArray(json.cases)) for (const c of json.cases) await PBAIDB.setItem('cases', c);
              if (Array.isArray(json.sermons)) for (const s of json.sermons) await PBAIDB.setItem('sermons', s);
              if (Array.isArray(json.research)) for (const r of json.research) await PBAIDB.setItem('research', r);
              if (Array.isArray(json.notes)) for (const n of json.notes) await PBAIDB.setItem('notes', n);
              if (Array.isArray(json.events)) for (const ev of json.events) await PBAIDB.setItem('events', ev);
              if (Array.isArray(json.goals)) for (const g of json.goals) await PBAIDB.setItem('goals', g);
              alert('¡Respaldo restaurado con éxito!');
              window.location.reload();
            }
          } catch (err) { alert('Archivo JSON inválido.'); }
          fileIn.value = '';
        });

        // 19. ACCESIBILIDAD, TEMA & AUDIO
        document.getElementById('btn-theme-toggle')?.addEventListener('click', () => {
          document.body.classList.toggle('light-theme');
          renderDashboardCharts();
        });

        document.getElementById('btn-role-switcher')?.addEventListener('click', () => {
          const roles = ['Psicólogo', 'Supervisor', 'Administrador', 'Consejero', 'Paciente'];
          let cur = localStorage.getItem('pbai_role') || 'Psicólogo';
          cur = roles[(roles.indexOf(cur) + 1) % roles.length];
          localStorage.setItem('pbai_role', cur);
          document.getElementById('btn-role-switcher').textContent = 'Rol: ' + cur;
        });

        let fontScale = 100;
        document.getElementById('btn-font-up')?.addEventListener('click', () => {
          fontScale = Math.min(140, fontScale + 10);
          document.documentElement.style.fontSize = fontScale + '%';
        });
        document.getElementById('btn-font-down')?.addEventListener('click', () => {
          fontScale = Math.max(80, fontScale - 10);
          document.documentElement.style.fontSize = fontScale + '%';
        });

        document.getElementById('btn-stop-voice')?.addEventListener('click', () => Narrator.stop());

        // PWA Offline detection
        window.addEventListener('online', () => document.getElementById('offline-indicator').style.display = 'none');
        window.addEventListener('offline', () => document.getElementById('offline-indicator').style.display = 'flex');
      }

      document.addEventListener('DOMContentLoaded', initApp);
    })();
  </script>
</body>
</html>
