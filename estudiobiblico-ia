  <style>
    /* ==========================================================================
       ESTILOS UNIFICADOS AUTÓNOMOS (PASTORALMENTE BÍBLICA AI)
       ========================================================================== */
    :root {
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-serif: 'Lora', Georgia, serif;
      --font-title: 'Cinzel', serif;

      --bg-primary: #020617;
      --bg-secondary: #0b1324;
      --bg-card: #0f172a;
      --bg-card-hover: #1e293b;
      --bg-surface: #030712;

      --color-emerald: #10b981;
      --color-emerald-deep: #064e3b;
      --color-teal: #14b8a6;
      --color-teal-deep: #0f766e;
      --color-amber: #f59e0b;
      --color-amber-gold: #fbbf24;
      --color-rose: #f43f5e;
      --color-blue: #3b82f6;
      --color-indigo: #6366f1;

      --text-primary: #f8fafc;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --border-color: #1e293b;
      --border-glow: rgba(20, 184, 166, 0.35);

      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      --radius-full: 9999px;

      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.4);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -2px rgba(0, 0, 0, 0.5);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.6), 0 4px 6px -4px rgba(0, 0, 0, 0.5);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.7), 0 8px 10px -6px rgba(0, 0, 0, 0.6);
    }

    body.light-theme {
      --bg-primary: #f8fafc;
      --bg-secondary: #f1f5f9;
      --bg-card: #ffffff;
      --bg-card-hover: #f8fafc;
      --bg-surface: #ffffff;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --border-glow: rgba(16, 185, 129, 0.3);
    }

    body.high-contrast {
      filter: contrast(1.25);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-family: var(--font-sans);
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.5;
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      background: radial-gradient(circle at 10% 0%, rgba(6, 78, 59, 0.15) 0%, transparent 40%),
                  radial-gradient(circle at 90% 20%, rgba(20, 184, 166, 0.1) 0%, transparent 45%),
                  var(--bg-primary);
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    ::selection {
      background-color: var(--color-amber);
      color: #020617;
    }

    .font-sans { font-family: var(--font-sans) !important; }
    .font-serif { font-family: var(--font-serif) !important; }
    .font-title { font-family: var(--font-title) !important; }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-title);
      color: var(--text-primary);
      letter-spacing: 0.02em;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: inherit;
      color: inherit;
    }

    .app-container {
      max-width: 1420px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      padding-left: clamp(12px, 2.5vw, 28px);
      padding-right: clamp(12px, 2.5vw, 28px);
    }

    .main-content {
      flex: 1 1 0%;
      padding-top: 1.25rem;
      padding-bottom: 3.5rem;
    }

    /* Cabecera / Navbar */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background-color: rgba(2, 6, 23, 0.94);
      border-bottom: 1px solid var(--border-color);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }
    body.light-theme .app-header {
      background-color: rgba(255, 255, 255, 0.94);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4.5rem;
      gap: 0.75rem;
    }

    .brand-wrapper {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
      text-decoration: none;
      flex-shrink: 0;
    }

    .brand-icon {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, #059669, #0f766e, #d97706);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(52, 211, 153, 0.4);
      box-shadow: 0 8px 16px rgba(4, 47, 46, 0.6);
      flex-shrink: 0;
      color: #fef3c7;
      font-size: 1.25rem;
    }

    .brand-text h1 {
      font-size: 1.25rem;
      font-weight: 800;
      line-height: 1.1;
      color: var(--text-primary);
      margin: 0;
    }

    .brand-text .highlight {
      color: var(--color-amber-gold);
      font-family: var(--font-sans);
      font-weight: 900;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-family: var(--font-serif);
      font-style: italic;
      margin: 0;
    }

    .badge-tag {
      font-size: 0.62rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 800;
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-full);
      background: rgba(6, 78, 59, 0.7);
      color: #6ee7b7;
      border: 1px solid rgba(16, 185, 129, 0.4);
      display: inline-block;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .main-nav::-webkit-scrollbar { display: none; }

    .nav-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 0.8rem;
      border-radius: var(--radius-md);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-secondary);
      background: transparent;
      border: 1px solid transparent;
      transition: all 0.15s ease-in-out;
      white-space: nowrap;
      cursor: pointer;
    }

    .nav-btn:hover {
      color: #ffffff;
      background: rgba(30, 41, 59, 0.7);
      border-color: rgba(51, 65, 85, 0.8);
    }

    .nav-btn.active {
      background: linear-gradient(90deg, rgba(6, 78, 59, 0.85), rgba(15, 23, 42, 0.95));
      color: var(--color-amber-gold);
      border-color: rgba(16, 185, 129, 0.5);
      box-shadow: 0 4px 12px rgba(6, 78, 59, 0.4);
    }
    body.light-theme .nav-btn.active {
      background: #e2e8f0;
      color: #064e3b;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-primary);
      transition: all 0.15s ease-in-out;
      box-shadow: var(--shadow-sm);
      user-select: none;
    }

    .btn:hover {
      background: var(--bg-card-hover);
      border-color: #475569;
      transform: translateY(-1px);
    }

    .btn:active {
      transform: translateY(0);
    }

    .btn-primary {
      background: linear-gradient(135deg, #059669, #0f766e);
      color: #020617;
      font-weight: 800;
      border-color: rgba(52, 211, 153, 0.5);
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, #10b981, #14b8a6);
      color: #020617;
    }

    .btn-gold {
      background: rgba(245, 158, 11, 0.2);
      color: var(--color-amber-gold);
      border-color: rgba(245, 158, 11, 0.45);
    }
    .btn-gold:hover {
      background: rgba(245, 158, 11, 0.35);
      color: #fef3c7;
    }

    .btn-danger {
      background: rgba(244, 63, 94, 0.2);
      color: #fda4af;
      border-color: rgba(244, 63, 94, 0.5);
    }

    .btn-sm {
      padding: 0.35rem 0.65rem;
      font-size: 0.72rem;
      border-radius: var(--radius-sm);
    }

    /* Hero Banner */
    .hero-banner {
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-glow);
      background: linear-gradient(135deg, #020617 0%, rgba(4, 47, 46, 0.65) 50%, #020617 100%);
      padding: clamp(1.25rem, 3vw, 2.25rem);
      box-shadow: var(--shadow-xl);
      margin-bottom: 1.5rem;
    }
    body.light-theme .hero-banner {
      background: linear-gradient(135deg, #ffffff 0%, #ecfdf5 50%, #f0fdf4 100%);
    }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-full);
      background: rgba(19, 78, 74, 0.7);
      border: 1px solid rgba(20, 184, 166, 0.4);
      color: #5eead4;
      font-size: 0.75rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .hero-title {
      font-size: clamp(1.4rem, 3vw, 2.2rem);
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .hero-desc {
      font-size: clamp(0.85rem, 1.4vw, 0.95rem);
      color: var(--text-secondary);
      font-family: var(--font-serif);
      line-height: 1.7;
      max-width: 900px;
    }

    /* Grids & Cards */
    .grid { display: grid; gap: 1rem; }
    .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
    .grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .grid-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }

    @media (min-width: 640px) {
      .sm\:grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sm\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .sm\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .sm\:grid-cols-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    }
    @media (min-width: 1024px) {
      .lg\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .lg\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .lg\:grid-cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
      .lg\:col-span-4 { grid-column: span 4 / span 4; }
      .lg\:col-span-5 { grid-column: span 5 / span 5; }
      .lg\:col-span-6 { grid-column: span 6 / span 6; }
      .lg\:col-span-7 { grid-column: span 7 / span 7; }
      .lg\:col-span-8 { grid-column: span 8 / span 8; }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      box-shadow: var(--shadow-md);
      transition: all 0.2s ease;
      position: relative;
    }
    .card:hover {
      border-color: rgba(51, 65, 85, 0.9);
      box-shadow: var(--shadow-lg);
    }

    .card-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.35rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .card-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-family: var(--font-serif);
      line-height: 1.5;
    }

    /* Formularios */
    .form-group { margin-bottom: 0.9rem; }
    .form-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }

    .input, .textarea, .select {
      width: 100%;
      padding: 0.65rem 0.85rem;
      background-color: var(--bg-secondary);
      border: 1px solid #334155;
      border-radius: var(--radius-md);
      color: var(--text-primary);
      font-size: 0.85rem;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .input:focus, .textarea:focus, .select:focus {
      border-color: var(--color-teal);
      box-shadow: 0 0 0 2px rgba(20, 184, 166, 0.25);
    }
    .textarea { min-height: 90px; resize: vertical; }

    /* Pestañas */
    .tabs-header {
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.5rem;
      margin-bottom: 1.25rem;
      scrollbar-width: none;
    }
    .tabs-header::-webkit-scrollbar { display: none; }

    .tab-btn {
      padding: 0.5rem 0.85rem;
      border-radius: var(--radius-md);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid transparent;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .tab-btn:hover { color: #ffffff; background: #1e293b; }
    .tab-btn.active {
      background: rgba(20, 184, 166, 0.2);
      color: #5eead4;
      border-color: rgba(20, 184, 166, 0.45);
      box-shadow: 0 2px 8px rgba(20, 184, 166, 0.2);
    }

    .view-pane { display: none; }
    .view-pane.active {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }

    .sub-pane { display: none; }
    .sub-pane.active {
      display: block;
      animation: fadeIn 0.2s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Pipeline 9 Etapas */
    .pipeline-step {
      padding: 1.1rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
      background: rgba(15, 23, 42, 0.65);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.75rem;
      transition: all 0.2s ease;
    }
    .pipeline-step.active {
      background: linear-gradient(180deg, rgba(4, 47, 46, 0.75), rgba(15, 23, 42, 0.95));
      border-color: var(--color-teal);
      box-shadow: 0 8px 24px rgba(20, 184, 166, 0.25);
      outline: 2px solid rgba(45, 212, 191, 0.5);
    }
    .step-num {
      width: 1.85rem;
      height: 1.85rem;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.8rem;
      background: #1e293b;
      color: #cbd5e1;
    }
    .pipeline-step.active .step-num {
      background: var(--color-teal);
      color: #020617;
    }

    /* Cronómetro y Modo Predicador */
    .timer-display {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 900;
      color: var(--color-amber-gold);
      text-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
      letter-spacing: 0.05em;
      text-align: center;
      margin: 0.75rem 0;
      user-select: none;
    }
    .timer-display.alert {
      color: var(--color-rose);
      animation: pulseAlert 1s infinite;
    }
    @keyframes pulseAlert {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.85; transform: scale(1.02); }
    }

    .pulpit-reading-area {
      padding: 1.5rem;
      background: rgba(2, 6, 23, 0.9);
      border: 1px solid #334155;
      border-radius: var(--radius-lg);
      line-height: 1.8;
      font-family: var(--font-serif);
      color: #e2e8f0;
      overflow-y: auto;
      max-height: 600px;
    }
    .reading-mode-notas { font-size: 1rem; }
    .reading-mode-tablet { font-size: 1.25rem; }
    .reading-mode-pulpito { font-size: 1.65rem; line-height: 2.1; font-weight: 500; }

    /* Teleprompter Fullscreen Mode */
    .teleprompter-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: #000000;
      color: #ffffff;
      padding: 2rem;
      display: none;
      flex-direction: column;
    }
    .teleprompter-overlay.open { display: flex; }
    .teleprompter-content {
      flex: 1;
      overflow-y: auto;
      font-size: clamp(1.8rem, 4vw, 3rem);
      line-height: 1.9;
      font-family: var(--font-sans);
      font-weight: 600;
      padding: 2rem 10vw;
    }

    /* Canvas de Firma */
    .signature-canvas-wrapper {
      background: #ffffff;
      border-radius: var(--radius-lg);
      border: 2px dashed #475569;
      padding: 8px;
      display: flex;
      justify-content: center;
    }
    canvas.signature-pad {
      width: 100%;
      max-width: 560px;
      height: 160px;
      background: #f8fafc;
      border-radius: var(--radius-md);
      cursor: crosshair;
      touch-action: none;
    }

    /* Modal del Buscador Universal */
    .search-modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 90;
      background: rgba(2, 6, 23, 0.85);
      backdrop-filter: blur(8px);
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding: clamp(1rem, 5vw, 3rem) 1rem;
    }
    .search-modal-backdrop.open { display: flex; }
    .search-modal-card {
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: var(--radius-xl);
      width: 100%;
      max-width: 720px;
      box-shadow: var(--shadow-xl);
      overflow: hidden;
      animation: fadeIn 0.2s ease-out;
    }

    /* Indicador de audio flotante */
    .voice-bar {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      z-index: 60;
      width: min(420px, calc(100vw - 2.5rem));
      background: rgba(15, 23, 42, 0.96);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(245, 158, 11, 0.6);
      border-radius: var(--radius-lg);
      padding: 0.75rem 1rem;
      box-shadow: var(--shadow-xl);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .offline-banner {
