      async function executeGlobalSearch(q) {
        const query = q.trim().toLowerCase();
        const resultsEl = document.getElementById('global-search-results');
        if (!resultsEl) return;

        if (!query) {
          resultsEl.innerHTML = '<p class="text-xs text-slate-500 font-serif text-center py-4">Comienza a escribir para buscar en toda la plataforma...</p>';
          return;
        }

        const cases = await PBAIDB.getAll('cases');
        const sermons = await PBAIDB.getAll('sermons');
        const research = await PBAIDB.getAll('research');
        const notes = await PBAIDB.getAll('notes');
        const courses = COURSES_DATA;

        const results = [];

        sermons.forEach(s => {
          if ((s.title + ' ' + s.text + ' ' + s.body).toLowerCase().includes(query)) {
            results.push({ type: 'Sermón', title: s.title, snippet: s.text || s.body, action: () => { loadSermonToEditor(s.id); switchMainView('view-sermones'); } });
          }
        });

        notes.forEach(n => {
          if ((n.title + ' ' + n.body + ' ' + n.tag).toLowerCase().includes(query)) {
            results.push({ type: 'Nota Cuaderno', title: n.title, snippet: n.body, action: () => { switchMainView('view-cuaderno'); } });
          }
        });

        research.forEach(r => {
